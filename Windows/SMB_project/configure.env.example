# ========================================================
# SMB Secure Share Configuration
# ========================================================

# The name of the local user group to be created
SMB_GROUP_NAME=SMBUsers

# The name of the restricted user to be created
SMB_USER_NAME=SMBUser

# The password for the restricted user (MUST BE STRONG!)
# e.g., mix of uppercase, lowercase, numbers, and special characters.
SMB_PASSWORD=YourStrongPasswordHere_123!

# The name of the folder that will be shared (e.g., "scan")
SMB_SHARE_NAME=scan

# (Optional) Provide an explicit path for the shared folder.
# If left blank, it will default to C:\Users\<Current_User>\<SMB_SHARE_NAME>
SMB_SHARE_PATH=
